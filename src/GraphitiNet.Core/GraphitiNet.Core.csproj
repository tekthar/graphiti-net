<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>GraphitiNet</RootNamespace>
    <PackageId>GraphitiNet</PackageId>
    <Description>Temporal knowledge graphs for AI agents in .NET: an independent C# rewrite of Graphiti (Python, by Zep). Ingestion, hybrid search, OpenAI and Microsoft.Extensions.AI providers, and an in-memory graph driver. Not affiliated with Zep Software, Inc.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="OpenAI" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="GraphitiNet.Core.Tests" />
    <InternalsVisibleTo Include="GraphitiNet.Driver.Tests" />
  </ItemGroup>

</Project>
