<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>GraphitiNet.Driver.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <!-- xUnit test method names use underscores. -->
    <NoWarn>$(NoWarn);CA1707</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="Xunit.SkippableFact" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- The scripted model, embedder and reranker of the acceptance tests, for the distributed group lock tests. -->
    <Compile Include="..\GraphitiNet.Acceptance.Tests\Fakes.cs" Link="Shared\Fakes.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\GraphitiNet.Core\GraphitiNet.Core.csproj" />
  </ItemGroup>

</Project>
